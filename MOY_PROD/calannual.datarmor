#!/bin/ksh
#SBATCH --depend=<JOBIDMOY>
#SBATCH --mem=1gb
#SBATCH --time=00:45:00
#SBATCH --job-name=<JBNAME>
#SBATCH --output=./JOBS-OUT/<JBNAME>.%j.out


cd SLURM_SUBMIT_DIR

echo $HOST

source /usr/share/Modules/init/bash
conda activate My-JupDask-2026-10
module list


ulimit -s unlimited
set -x
CONFIG=<CONFIG>
CASE=<CASE>

CONFCASE=${CONFIG}-${CASE}
CTL_DIR=<WPDIR>

#. $HOME/.profile
cd $CTL_DIR
. ./config_moy.ksh
#
./mvcalmoy.ksh <year>
